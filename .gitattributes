# Мөрийн төгсгөлийг файлын төрлөөр тогтооно.
#
# Windows дээр хөгжүүлж, Ubuntu дээр ажиллуулдаг тул энэ файл заавал:
# shell скрипт CRLF-тэй clone хийгдвэл Линукс дээр
# «bash: bad interpreter: No such file or directory» алдаа өгнө.

* text=auto eol=lf

# Линукс дээр ажилладаг — ЗААВАЛ LF.
*.sh    text eol=lf
Dockerfile text eol=lf
*.conf  text eol=lf

# Windows дээр ажилладаг — CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Хоёртын файл — хөндөхгүй.
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.dump  binary
